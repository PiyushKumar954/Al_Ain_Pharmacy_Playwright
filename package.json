  "main": "index.js",
  "scripts": {
    "clean": "node -e \"const fs = require('fs'); ['allure-results', 'allure-report', 'test-results', 'playwright-report'].forEach(d => fs.rmSync(d, { recursive: true, force: true }));\"",
    "test": "npm run clean && playwright test",
    "test:chrome": "npm run clean && playwright test --project=chromium --headed",
    "allure:serve": "allure serve allure-results",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "allure-commandline": "^2.46.1",
    "allure-playwright": "^3.12.2"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "xlsx": "^0.18.5"
  }
}
